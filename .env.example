# Clonador de voz — plantilla de configuración.
# Copia este archivo como `.env` y edítalo con tus datos.
# El `.env` real NO se sube a git (está en .gitignore).

# Quién habla en los vídeos (ej.: "Marie Curie", "Mi abuelo")
PERSONAJE=Mi personaje

# Una línea de contexto (se muestra en la app)
DESCRIPCION=Entrevistas donde habla una sola persona, sin música de fondo.

# Lista de vídeos separada por comas: URLs de YouTube o rutas locales (mp4/mp3/m4a/wav).
# Solo usa vídeos tuyos, con licencia CC o con permiso.
VIDEOS=

# Calidad de descarga (la imagen da igual: 480 basta y descarga rápido)
ALTURA_MAX=480

# Frecuencias de trabajo (lo que esperan los modelos)
FS_VOZ=16000
FS_MUSICA=44100
